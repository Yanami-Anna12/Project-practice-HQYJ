# 复制为 .env 后按本机情况修改
APP_NAME="RBAC 权限管理系统"
DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rbac_db

JWT_SECRET=please-change-this-to-a-random-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
