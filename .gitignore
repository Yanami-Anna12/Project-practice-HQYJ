/物流项目/backend/__pycache__/
/物流项目/backend/app/__pycache__/
/物流项目/backend/app/models/__pycache__/
/物流项目/backend/app/routers/__pycache__/
/物流项目/backend/app/services/__pycache__/
/物流项目/frontend/node_modules/
