pageType: content
background:
  type: solid
  color: $paper
notes: |
  30 秒。四个数据范围由小到大，越权判断靠 DATA_SCOPE_ORDER。
  强调：权限的最终防线在后端拦截，页面上的隐藏只是体验优化。
elements:
  - elementId: p06-top
    elementType: shape
    bounds: [0, 0, 960, 5]
    shapeName: rect
    fill: {type: solid, color: $accent}
    border: {color: $accent, width: 0}
  - elementId: p06-code
    elementType: text
    bounds: [48, 32, 560, 16]
    content:
      style: $section
      text: 05 / 数据权限隔离
  - elementId: p06-title
    elementType: text
    bounds: [48, 54, 864, 38]
    content:
      text: 四种数据范围，由小到大逐级放大可见面
      style: $pageTitle
  - elementId: p06-axis
    elementType: line
    bounds: [80, 300, 800, 1]
    viewBox: [800, 1]
    points: 0,0 800,0
    border: {width: 1.5, color: $ink}
  - elementId: p06-s1
    elementType: shape
    bounds: [80, 168, 168, 132]
    shapeName: rect
    fill: {type: solid, color: $surface}
    border: {color: $ink, width: 1.5}
  - elementId: p06-s1-h
