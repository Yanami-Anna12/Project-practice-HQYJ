# ============================================================================
# 充电桩运维管理 AI Agent 平台 —— 后端环境变量样例
# 复制为 .env 后按需修改。敏感信息请勿提交到代码仓库（PDF 9.3 配置管理）。
# ============================================================================

# ---------------- 应用 ----------------
APP_NAME=充电桩运维管理 AI Agent 平台
ENV=dev
DEBUG=true
# 端口默认 8010，刻意与同机「车辆智能调度 Agent」项目（8000）错开
HOST=127.0.0.1
PORT=8010

# ---------------- 数据库 ----------------
# 本地开发：SQLite（开箱即跑）
DATABASE_URL=sqlite+aiosqlite:///./data/maintenance.db
# 生产（PDF 2.2 PostgreSQL 15+）：取消注释并填写
# DATABASE_URL=postgresql+psycopg://maintenance:password@127.0.0.1:5432/maintenance
DB_ECHO=false

# ---------------- 认证 ----------------
# 生产环境务必替换为随机密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-charging-pile-ops-agent
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------- LLM（PDF 2.2：DeepSeek-V4 API / Qwen2.5-72B-Instruct）----------------
# 留空则自动读取 Windows 机器级环境变量 DEEPSEEK_API_KEY；
# 都没有时降级为确定性规则引擎（PDF 4.1：LLM 只做解释与辅助）。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
AI_ENABLED=true
LLM_FALLBACK_ENABLED=true

# ---------------- 可观测性（PDF 8.1）----------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=maintenance-agent

# ---------------- 缓存与队列（PDF 2.2）----------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ---------------- 向量库（PDF 2.2 / 4.7）----------------
# local：内置 TF-IDF 检索（无需外部依赖）
VECTOR_STORE=local
MILVUS_URI=http://127.0.0.1:19530
EMBEDDING_MODEL=text-embedding-v4
KB_TOP_K=5

# ---------------- 对象存储（PDF 2.2）----------------
STORAGE_BACKEND=local
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=maintenance

# ---------------- 微信与消息推送（PDF 7.3）----------------
WECHAT_APPID=
WECHAT_SECRET=
FEISHU_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------- 外部平台集成（PDF 7.1 / 7.2）----------------
STORAGE_PLATFORM_API=
CHARGING_PLATFORM_API=
POWER_MARKET_API=
WEATHER_API=
MAP_API_KEY=
OUTBOUND_TIMEOUT=10

# ---------------- 业务规则（PDF 3.12 / 4.9）----------------
REPORT_DAILY_CRON_HOUR=2
REPORT_WEEKLY_CRON_HOUR=3
REPORT_MONTHLY_CRON_HOUR=4
WORK_ORDER_DUE_SOON_HOURS=24
MAX_REPLAN_COUNT=3

# ---------------- CORS ----------------
CORS_ORIGINS=http://localhost:5185,http://127.0.0.1:5185,http://localhost:4173,http://127.0.0.1:4173
