version: v2
title: 充电桩运维管理 AI Agent 平台 项目答辩
size:
  - 960
  - 540
template:
  id: dsh-engineering-blueprint
  name: Engineering Blueprint
theme:
  colors:
    paper: '#F0EAE0'
    surface: '#FFFFFF'
    ink: '#252824'
    muted: '#6E6A62'
    rule: '#C9C2B6'
    accent: '#B5392A'
    accentPale: '#F2DED8'
    steel: '#9AA09B'
    white: '#FFFFFF'
  textStyles:
    display:
      fontFamily: &ref_0
        latin: Arial
        ea: Microsoft YaHei
        mac: PingFang SC
        win: Microsoft YaHei
      fontSize: 34
      color: $ink
      bold: true
      lineHeight: 1.14
    pageTitle:
      fontFamily: *ref_0
      fontSize: 23
      color: $ink
      bold: true
      lineHeight: 1.16
    section:
      fontFamily: *ref_0
      fontSize: 9
      color: $muted
      bold: true
      letterSpacing: 1.3
    body:
      fontFamily: &ref_1
        latin: Arial
        ea: Microsoft YaHei
        mac: PingFang SC
        win: Microsoft YaHei
      fontSize: 12
      color: $ink
      lineHeight: 1.4
    small:
      fontFamily: *ref_1
      fontSize: 9
      color: $muted
      lineHeight: 1.3
    metric:
      fontFamily: *ref_0
      fontSize: 34
      color: $ink
      bold: true
    label:
      fontFamily: *ref_1
      fontSize: 8.5
      color: $ink
      bold: true
      letterSpacing: 0.9
  tableStyles:
    spec:
      cellStyle:
        fontFamily: *ref_1
        fontSize: 9
        color: $ink
        fill:
          type: solid
          color: $surface
        border:
          width: 0.7
          color: $rule
        align:
          - left
          - middle
      firstRowStyle:
        fill:
          type: solid
          color: $ink
        color: $white
        bold: true
        align:
          - center
          - middle
pages:
  - pages/01.page
  - pages/02.page
  - pages/03.page
  - pages/04.page
  - pages/05.page
  - pages/06.page
  - pages/07.page
  - pages/08.page
  - pages/09.page
  - pages/10.page
  - pages/11.page
  - pages/12.page
