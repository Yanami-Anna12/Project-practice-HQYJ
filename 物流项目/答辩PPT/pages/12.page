    elementType: shape
    bounds: [0, 0, 960, 6]
    shapeName: rect
    fill: {type: solid, color: $yellow}
    border: {color: $yellow, width: 0}
  - elementId: p12-code
    elementType: text
    bounds: [54, 40, 560, 18]
    content:
      style: $section
      text: 11 / 总结
  - elementId: p12-title
    elementType: text
    bounds: [54, 66, 520, 100]
    content:
      text: |-
        把调度经验
        做成可执行的规则
      style: $display
      fontSize: 38
      color: $white
      lineHeight: 1.14
  - elementId: p12-sub
    elementType: text
    bounds: [54, 178, 490, 74]
    content:
      text: |-
        可执行 —— 方案能直接下发派车
        可解释 —— 每套方案带评分与推荐理由
        可追溯 —— 下发记录与审计日志只追加
      style: $body
      fontSize: 12.5
      color: $steel
      lineHeight: 1.75
