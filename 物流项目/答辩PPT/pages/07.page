pageType: content
background:
  type: solid
  color: $paper
notes: |
  25 秒。这一页只讲一个判断：边界情况交给规则，不交给 AI。
  举三个真实例子说明规则在哪一层拦住。
elements:
  - elementId: p07-top
    elementType: shape
    bounds: [0, 0, 960, 6]
    shapeName: rect
    fill: {type: solid, color: $yellow}
    border: {color: $yellow, width: 0}
  - elementId: p07-code
    elementType: text
    bounds: [54, 34, 560, 18]
    content:
      style: $section
      text: 06 / 规则与 AI 的分工
  - elementId: p07-title
    elementType: text
    bounds: [54, 58, 852, 42]
    content:
