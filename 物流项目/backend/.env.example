# 复制为 .env 后按本机情况修改

# ===== 应用 =====
APP_NAME="车辆智能调度 Agent"
DEBUG=true

# ===== 数据库 =====
# 本机用的是 MySQL 8.0。若要切到 PostgreSQL（技术方案文档的推荐选型）：
#   1. 改 drivername（见 app/config.py 的 database_url）
#   2. 安装 psycopg 驱动，替换 requirements.txt 里的 PyMySQL
#   3. 本项目的模型未使用任何 MySQL 方言，可以直接迁移
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=logistics_db

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-random-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== CORS =====
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ===== 调度求解器 =====
SOLVER_TIMEOUT_SECONDS=30
REPLAN_MAX_COUNT=3

# ===== LLM（可选，留空则方案解释降级）=====
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 初始账号密码 =====
ADMIN_INIT_PASSWORD=admin123
DEMO_PASSWORD=123456
